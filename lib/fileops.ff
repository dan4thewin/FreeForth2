\ fileops.ff — file operations: lseek, ioctl, select, stat
needs ior.ff

: lseek  _lseek ; ( whence offset fd -- offset )
: ioctl  ioctl3 ; ( arg request fd -- result )
\ select is in boot

: mkst` create` _stat.sz allot` ;
: stat nip tuck _stat.sz erase _stat ; ( addr len statbuf -- result )
" fileops" features append ;
