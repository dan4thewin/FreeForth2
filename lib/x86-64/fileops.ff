( fileops.ff — file operations: lseek, ioctl, select, stat )
( x86-64 syscall numbers differ from i386 )
needs ior.ff

: lseek  3  8 syscall ; ( whence offset fd -- offset )
: ioctl  3 16 syscall ; ( arg request fd -- result )
: select 5 23 syscall ; ( timeout exceptfds writefds readfds nfds -- result )

( x86-64 struct stat is 144 bytes; st_size at offset 48 )
: mkst` create` 144 allot` ;
: stat ( addr len statbuf -- result )
  nip swap 2 4 syscall
;
48 constant st.size
" fileops" features append ;
