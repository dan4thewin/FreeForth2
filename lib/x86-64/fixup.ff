\ fixup.ff  --  self-patching first-call resolution for libc symbols
\ DG's mechanism; Lavarenne's i386 used libc. with direct dlsym.
\
\ i386 fixup replaces a 5-byte "call _xxx" with BB(mov ebx,imm32).
\ x86-64 handles are 64-bit, so we write an 11-byte trampoline:
\   48BB<8>(movabs rbx,funh) C3(ret)
\ Then patch the call's relative offset to point to the trampoline.
\
\ Trampolines go in _fixbuf, not at here (rbp)  --  during anonymous
\ block execution, here points to the executing code itself.
\
\ x86-64 fixup relies on tail-call optimization (E8->E9) so it is
\ JMP'd to, not called. i386 has rdrop because fixup is called (E8).
\
\ IMPORTANT: the hidden definition MUST end with explicit semicolon:
\   :. _xxx "symbol" fixup ;
\ Without ;, _colon doesn't terminate the previous def, so tail-call
\ optimization never triggers and fixup patches the wrong call.
variable _fixbuf pvt 1024 allot
variable _fixptr pvt
_fixbuf _fixptr! ;
: fixup ( addr len -- )
  libc@ #fun
  _fixptr@
  $48 over c! $BB over 1+ c!
  2dup 2+ !
  $C3 over 10+ c!
  dup 11+ _fixptr!
  nip
  r> 5- dup>r
  - 5- r 1+ d!
;
" fixup" features append ;
