\ net.ff  --  BSD socket syscall wrappers for x86-64
\ needs net.ff ; arg1 on TOS, argN deepest

\ address families
1  constant AF_UNIX
2  constant AF_INET
10 constant AF_INET6

\ socket types
1 constant SOCK_STREAM
2 constant SOCK_DGRAM
3 constant SOCK_RAW

\ socket options
1 constant SOL_SOCKET
2 constant SO_REUSEADDR
9 constant SO_KEEPALIVE

\ protocol
0 constant IPPROTO_IP
6 constant IPPROTO_TCP
17 constant IPPROTO_UDP

\ misc
0 constant INADDR_ANY
$100007F constant INADDR_LOOPBACK

\ shutdown modes
0 constant SHUT_RD
1 constant SHUT_WR
2 constant SHUT_RDWR

\ socket syscalls
: socket    ( proto type domain -- fd )  3 41 syscall ;
: connect   ( addrlen addr fd -- ior )  3 42 syscall ;
: sendto    ( tolen to flags len buf fd -- n )  6 44 syscall ;
: recvfrom  ( fromlen from flags len buf fd -- n )  6 45 syscall ;
: shutdown  ( how fd -- ior )  2 48 syscall ;
: bind      ( addrlen addr fd -- ior )  3 49 syscall ;
: listen    ( backlog fd -- ior )  2 50 syscall ;
: getsockname ( addrlen addr fd -- ior )  3 51 syscall ;
: getpeername ( addrlen addr fd -- ior )  3 52 syscall ;
: socketpair  ( sv proto type domain -- ior )  4 53 syscall ;
: setsockopt  ( optlen optval optname level fd -- ior )  5 54 syscall ;
: getsockopt  ( optlen optval optname level fd -- ior )  5 55 syscall ;
: pselect6    ( sigmask timeout exceptfds writefds readfds nfds -- n ) 6 270 syscall ;
: accept4     ( flags addrlen addr fd -- newfd )  4 288 syscall ;

\ convenience: send/recv without address args
: send ( flags len buf fd -- n ) >r >r >r >r 0 0 r> r> r> r> 6 44 syscall ;
: recv ( flags len buf fd -- n ) >r >r >r >r 0 0 r> r> r> r> 6 45 syscall ;

\ htons  --  byte-swap 16-bit value for network byte order
: htons ( n -- n ) dup 8 >> $FF & swap $FF & 8 << | ;
