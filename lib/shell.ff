\ shell.ff  --  OS interface: system, shell, cd, !!
\ All native syscalls — no libc dependency.
needs ior.ff

\ Native system via fork/execve/wait
create _sh_argv pvt 4 cell* allot
variable _wstat pvt
: system ( addr len -- status )
  drop 2 cell* _sh_argv + !
  "/bin/bash" drop _sh_argv !
  "-c" drop 1 cell* _sh_argv + !
  0 3 cell* _sh_argv + !
  fork 0- 0= IF envp _sh_argv _sh_argv @ execve drop -1 exit THEN
  drop 0 _wstat ! 0 0 _wstat 0 wait4 drop _wstat w@ $FF00 & 8 >> ;

: man` >in@ 4- lnparse + over- ( <mantopic> -- ; fallthru )
: shell system 0; ior! !"shell_call_failed" ( addr len -- )
: cd` wsparse zt chdir ?ior ( <newdir> -- )
;
: !!` lnparse 2dup + 0 swap c! shell ; ( <line> -- )
" shell" features append ;
