\ shell.ff  --  OS interface: system, shell, cd, !!
\ getenv is in boot code: fflin.boot [i386], fflin64.boot [x86-64]
needs ior.ff

[~] getpid [IF]
needs fixup.ff
:. _getpid "getpid" fixup ;
:  getpid 0 0 _getpid #call ; ( -- pid )
:. _getppid "getppid" fixup ;
:  getppid 0 0 _getppid #call ; ( -- ppid )
[THEN]

[64] [IF]
\ Native system via fork/execve/wait  --  no libc dependency
create _sh_argv pvt 32 allot
variable _wstat pvt
: system ( addr len -- status )
  drop _sh_argv 16+ !
  "/bin/bash" drop _sh_argv !
  "-c" drop _sh_argv 8+ !
  0 _sh_argv 24+ !
  fork 0- 0= IF envp _sh_argv _sh_argv @ execve drop -1 exit THEN
  drop 0 _wstat ! 0 0 _wstat 0 wait4 drop _wstat w@ $FF00 & 8 >> ;
[ELSE]
needs fixup.ff
:. _system "system" fixup ;
:  system zt 1 dup _system #call ; ( addr len -- status )
[THEN]

: man` >in@ 4- lnparse + over- ( <mantopic> -- ; fallthru )
: shell system 0; ior! !"shell_call_failed" ( addr len -- )
: cd` wsparse zt chdir ?ior ( <newdir> -- )
;
: !!` lnparse 2dup + 0 swap c! shell ; ( <line> -- )
" shell" features append ;
