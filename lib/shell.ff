( shell.ff — OS interface: getenv, getpid, system, shell, cd, !! )
needs fixup.ff
needs ior.ff
needs syscalls.ff

( Native getenv — walks envp directly, no libc dependency.        )
( Works in turnkey binaries where libc getenv SEGVs.              )
( envp is a NULL-terminated array of "KEY=VALUE" C-string ptrs.   )
variable _gk pvt variable _gl pvt
: getenv ( addr len -- vaddr vlen | 0 0 )
  _gl ! _gk !
  ff_envp@ BEGIN dup @ 0- 0<> WHILE drop
    _gk @ over @ _gl @ $-
    0- 0= drop IF
      dup @ _gl @ + c@ '= = drop drop IF
        @ _gl @ + 1+ zlen ;THEN
    THEN
    8+
  REPEAT drop 0 0 ;

:. _getpid "getpid" fixup ;
:  getpid 0 0 _getpid #call ; ( -- pid )
:. _getppid "getppid" fixup ;
:  getppid 0 0 _getppid #call ; ( -- ppid )
:. _system "system" fixup ;
:  system zt 1 dup _system #call ; ( addr len -- status )

: man` >in@ 4- lnparse + over- ( <mantopic> -- ; fallthru )
: shell system 0; ior! !"shell_call_failed" ( addr len -- )
: cd` wsparse zt 1 _sys.chdir syscall ?ior ( <newdir> -- )
;
: !!` lnparse shell ; ( <line> -- )
" shell" features append ;
