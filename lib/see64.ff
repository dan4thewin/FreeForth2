\ see64.ff — native disassembler for ff64 (x86-64)
\ see` ( <name> -- )       native disassembly of compiled word
\ see. ( @ -- )            native disassembly starting at address
\ findxt ( @ # -- xt len ) looks for string in headers
\ findh ( @ -- hdr@ off )  finds header with xt closest to @
\ findnm ( @ -- )          types name of closest header + offset

: int3` $CC c, ;
: xx` $41 c, $BA c, d, ; \ mov r10d, TOS

variable xt pvt
variable _fh pvt
variable _tty pvt
create _tiob pvt 64 allot
_tiob $5401 1 3 16 syscall 0- 0< IF 0 ELSE 1 THEN _tty ! drop ;
:. sz-		2dup h.sz+ c@ - drop ;
:. nm-		3dup h.nm+ swap $- drop ;
:. hdr-		sz- 0= IF nm- ;THEN ;
:. skip?	dup h.ct+ c@ $20& drop ;
:. stop?	dup h.sz+ c@ 0<>; !"not_found" ;
:. nexth	BEGIN h.sz+ c@+ + 1+ dup h.sz+ c@ 0- 0= drop IF ;THEN skip? 0<> WHILE REPEAT ;
: findxt	here xt! H@
		BEGIN dup h.sz+ c@ 0- 0<> drop WHILE
		  hdr- 0= IF nip nip @ xt@ over- ;THEN dup@ xt! h.next
		REPEAT !"not_found" ;
: findh		H@ stop?
		BEGIN 2dup @ < 2drop WHILE nexth stop? REPEAT
		dup _fh! swap over @ - ;
: findnm	findh swap h.sz+ c@+ type 0; ."+" .x ;

create buf pvt 160 allot
$100 :. ba		xx buf append ;
$103 :. ca		xx buf appendc ;

\ Spacing helpers — append N spaces to buf
:. sp2 $20 ca $20 ca ;
:. sp3 sp2 $20 ca ;
:. sp4 sp3 $20 ca ;
:. sp5 sp4 $20 ca ;

\ Hex append — iterative nibble output to buf (replaces pictured number output)
:. xdigit	$F& $30+ dup $39 > 2drop IF $27 + THEN ca ;
:. _xlen	0 swap BEGIN swap 1+ swap 4 >> 0- 0= UNTIL drop ;
$102 :. xa	xx 0- 0< IF '-' ca negate THEN
		0- 0= IF '0' ca drop ;THEN
		dup _xlen TIMES dup r 4* >> xdigit LOOP drop ;

\ Mnemonic tables — packed names, no spaces
create mne3 pvt 39 allot "movleajmppopretstdnopcqocdqcldshlshrsar" mne3 swap move
:. m3	3* mne3+ 3 ba sp4 ;
:. m3.	3* mne3+ 3 ba ;
create mne4 pvt 16 allot "testxchgcallpush" mne4 swap move
:. m4	4* mne4+ 4 ba sp3 ;
create mne5 pvt 10 allot "movzxmovsx" mne5 swap move
:. m5	5* mne5+ 5 ba sp2 ;

\ Suffix helpers — char-by-char append
:. ,a	',' ca ;
:. ,byte	',' ca 'b' ca 'y' ca 't' ca 'e' ca ;
:. ,word	',' ca 'w' ca 'o' ca 'r' ca 'd' ca ;
:. ,1	',' ca '1' ca ;
:. ,cl	',' ca 'c' ca 'l' ca ;
:. ,rip	sp3 'r' ca 'i' ca 'p' ca ;
:. ???.	'?' ca '?' ca '?' ca ;

\ REX prefix state (set by rex handler, consumed by next opcode)
variable rex pvt
$200 :. rexW?	xx rex@ 8& drop ;
$200 :. rexR?	xx rex@ 4& drop ;
$200 :. rexX?	xx rex@ 2& drop ;
$200 :. rexB?	xx rex@ 1& drop ;

\ Register name tables — 64-bit, 32-bit, 8-bit
create regs64 pvt 32 allot "raxrcxrdxrbxrsprbprsirdi" regs64 swap move
create regs32 pvt 24 allot "eaxecxedxebxespebpesiedi" regs32 swap move
create regs8  pvt 16 allot "alcldlblahchdhbh"         regs8  swap move
create regsx  pvt 24 allot "r8 r9 r10r11r12r13r14r15" regsx  swap move
$300 :. reg		xx >r swap 7& over* r> + swap ba ;
$301 :. r64x		xx dup 8 u< 2drop IF 3 regs64 reg ;THEN 8- 3 regsx reg ;
$302 :. r64		xx rexB? 0<> IF 8+ THEN r64x ;
$303 :. r64r		xx rexR? 0<> IF 8+ THEN r64x ;
$304 :. r32		xx 3 regs32 reg ;
$305 :. r8		xx 2 regs8  reg ;

\ Instruction format helpers (must be before ModRM which uses .le)
$400 :. .A		xx dup ."   $" .l .":  " ;			\ @ -- @      ; show address
$401 :. .B		xx dup 1+ swap c@ dup .b space ;		\ @ -- @+1 c  ; show 1 byte
$402 :. .le		xx dup 4 TIMES c@+ .b REPEAT drop ;	\ @ -- @      ; show 4 LE bytes
$403 :. .le8		xx dup 8 TIMES c@+ .b REPEAT drop ;	\ @ -- @      ; show 8 LE bytes
$404 :. .N		xx dup 4+ swap .le space d@ ;		\ @ -- @+4 n  ; show 4-byte val
$405 :. .Q		xx dup 8+ swap .le8 space @ ;		\ @ -- @+8 n  ; show 8-byte val

variable unknown pvt
:. ???		???. unknown dup@ 1+ swap ! ;
:. .A?		.B drop ??? 0 ;

\ ModRM/SIB decoding for 64-bit
$500 :. sib		xx dup c@ dup .b space
  dup 7& dup 5 = 2drop IF drop dup $20& 0<> drop IF r64 ;THEN 'r' ca 'i' ca 'p' ca ELSE r64 THEN
  drop 1+ ;
$501 :. rip+32		xx .N over+ xa ,rip ;
$502 :. r@.		xx 4 CASE sib ;THEN 5 CASE rip+32 ;THEN r64 ;
$503 :. disp		xx 0- 0>= IF '+' ca THEN xa ;
$504 :. r@+8.		xx dup 4 = 2drop IF drop sib ELSE r64 THEN dup cs@ dup .b space disp 1+ ;
$505 :. r@+32.		xx r64 dup 4+ swap .le space d@ disp ;
$506 :. ob		xx '[' ca ;
$507 :. cb		xx ']' ca ;
$508 :. r@		xx ob r@.    cb ;
$509 :. r@+8		xx ob r@+8.  cb ;
$50A :. r@+32		xx ob r@+32. cb ;

variable regxt pvt
$600 :. ext		xx dup 3 >> 7& ;
$601 :. split		xx dup 7& swap ext swap 6 >> ;
$602 :. mod.		xx 3& 0 CASE r@ ;THEN 1 CASE r@+8 ;THEN 2 CASE r@+32 ;THEN drop regxt@ execute ;
$603 :. rm.		xx split swap regxt@ execute ',' ca mod. ;
$604 :. mr.		xx swap >r split >rswapr> r> -rot mod. ',' ca swap regxt@ execute ;
$605 :. rm		xx r64r ' regxt! rm. ;
$606 :. mr		xx r64r ' regxt! mr. ;
$607 :. rm8		xx r8  ' regxt! rm. ;
$608 :. mr8		xx r8  ' regxt! mr. ;
$609 :. mod		xx r64r ' regxt! mod. ;
$60A :. mod8		xx r8  ' regxt! mod. ;

$700 :. 0f<>		xx $f- drop 0= IF ??? rdrop THEN ;
$701 :. 0f=		xx $f- drop 0<> IF ??? rdrop THEN ;

\ Opcode dispatch table — 256 entries
create op pvt 256 8* allot ;
.A? ' 256 TIMES dup op r 8* + ! REPEAT drop ;
$1 :. callop	xx dup c@ 8* op+ @ execute ;
$2 :. rexskip	xx dup c@ $F0& $40- 0<>; drop .B $F& rex! ;
:. _atx		_tty @ 0- 0<> drop IF $1B emit '[' emit '4' emit '1' emit 'G' emit ;THEN 9 emit ;
$3 :. oneop	xx .A 0 rex! rexskip 0 buf! callop
		_atx buf c@+ type cr ;
$4 : see.	xx 0 unknown!
		BEGIN dup oneop
		  >r nip r>
		  0- 0<> IF 2drop
		  unknown@ 0; ."unknown bytes: " . cr ;THEN
		  drop
		AGAIN ;

\ Helpers for opcode definitions
:. jba		'$' ca dup xa $20 ca
		findh swap h.sz+ c@+ ba 0; '+' ca xa ;
:. se		dup $80& 0; drop -128 | ;

create 80exts pvt 24 allot "addor adcsbbandsubxorcmp" 80exts swap move
:. 80exta	7& 3* 80exts+ 3 ba sp4 ;

\ Byte-count instruction readers (address already printed by oneop)
:. 1b		.B drop ;
:. 2b		.B drop .B ;
:. 3b		.B drop .B swap .B swap 2xchg ;
:. 5b		.B drop .N ;

\ ;op` — register an opcode handler
: ;op` ;` 8* op + H@ @ swap ! ;

\ 2-byte opcodes starting with 0F — uses separate dispatch table
create op0f pvt 256 8* allot ;
:. unk0f	.B drop ??? 0 ;
unk0f ' 256 TIMES dup op0f r 8* + ! REPEAT drop ;
$0f :. 0f	.B drop dup c@ 8* op0f+ @ execute ;op

\ --- Arithmetic --- (80exts indices: 0=add 1=or 2=adc 3=sbb 4=and 5=sub 6=xor 7=cmp)
$01 :. add	2b 0 80exta mr 0 ;op
$03 :. add.	2b 0 80exta rm 0 ;op
$09 :. or	2b 1 80exta mr 0 ;op
$0b :. or.	2b 1 80exta rm 0 ;op
$11 :. adc	2b 2 80exta mr 0 ;op
$21 :. and	2b 4 80exta mr 0 ;op
$23 :. and.	2b 4 80exta rm 0 ;op
$29 :. sub	2b 5 80exta mr 0 ;op
$2b :. sub.	2b 5 80exta rm 0 ;op
$31 :. xor	2b 6 80exta mr 0 ;op
$33 :. xor.	2b 6 80exta rm 0 ;op
$39 :. cmp	2b 7 80exta mr 0 ;op
$3b :. cmp.	2b 7 80exta rm 0 ;op

\ REX prefixes handled by rexskip in oneop, no opcode table entries needed

\ --- Push/Pop --- (mne4: 3=push, mne3: 3=pop)
$50 :. pushA	1b 3 m4 0 r64x 0 ;op
$51 :. pushC	1b 3 m4 1 r64x 0 ;op
$52 :. pushD	1b 3 m4 2 r64x 0 ;op
$53 :. pushB	1b 3 m4 3 r64x 0 ;op
$55 :. pushBP	1b 3 m4 5 r64x 0 ;op
$56 :. pushSI	1b 3 m4 6 r64x 0 ;op
$57 :. pushDI	1b 3 m4 7 r64x 0 ;op
$58 :. popA	1b 3 m3 0 r64x 0 ;op
$59 :. popC	1b 3 m3 1 r64x 0 ;op
$5a :. popD	1b 3 m3 2 r64x 0 ;op
$5b :. popB	1b 3 m3 3 r64x 0 ;op
$5d :. popBP	1b 3 m3 5 r64x 0 ;op
$5e :. popSI	1b 3 m3 6 r64x 0 ;op
$5f :. popDI	1b 3 m3 7 r64x 0 ;op

\ --- Immediate push ---
$68 :. pushi32	5b 3 m4 xa 0 ;op
$6a :. pushi8	2b 3 m4 se xa 0 ;op

\ --- Short conditional jumps ---
:. j_	se over+ dup jba drop 0 ;
$72 :. jb	2b 'j' ca 'b' ca sp5 j_ ;op
$73 :. jae	2b 'j' ca 'a' ca 'e' ca sp4 j_ ;op
$74 :. jz	2b 'j' ca 'z' ca sp5 j_ ;op
$75 :. jnz	2b 'j' ca 'n' ca 'z' ca sp4 j_ ;op
$76 :. jbe	2b 'j' ca 'b' ca 'e' ca sp4 j_ ;op
$77 :. ja	2b 'j' ca 'a' ca sp5 j_ ;op
$78 :. js	2b 'j' ca 's' ca sp5 j_ ;op
$79 :. jns	2b 'j' ca 'n' ca 's' ca sp4 j_ ;op
$7c :. jl	2b 'j' ca 'l' ca sp5 j_ ;op
$7d :. jge	2b 'j' ca 'g' ca 'e' ca sp4 j_ ;op
$7e :. jle	2b 'j' ca 'l' ca 'e' ca sp4 j_ ;op
$7f :. jg	2b 'j' ca 'g' ca sp5 j_ ;op

\ --- Group 1: immediate arithmetic ---
$80 :. 80	3b ext 80exta 7& r8 ,a xa 0 ;op
$81 :. 81	2b ext 80exta 7& r64 ,a .le dup d@ xa 4+ 0 ;op
$83 :. 83	2b ext 80exta 7& r64 ,a dup cs@ dup .b xa 1+ 0 ;op

\ --- 0F 8x: long conditional jumps (sub-handlers for op0f table) ---
\ Sub-handler receives (addr+1) where 0F byte already printed by 0f handler.
\ 5b reads: sub-opcode + 4-byte disp → (addr+6 disp32). j_i32 computes target.
:. j_i32	over+ dup jba drop 0 ;
:. jbi32	5b 'j' ca 'b' ca sp5 j_i32 ;
:. jaei32	5b 'j' ca 'a' ca 'e' ca sp4 j_i32 ;
:. jzi32	5b 'j' ca 'z' ca sp5 j_i32 ;
:. jnzi32	5b 'j' ca 'n' ca 'z' ca sp4 j_i32 ;
:. jbei32	5b 'j' ca 'b' ca 'e' ca sp4 j_i32 ;
:. jai32	5b 'j' ca 'a' ca sp5 j_i32 ;
:. jsi32	5b 'j' ca 's' ca sp5 j_i32 ;
:. jli32	5b 'j' ca 'l' ca sp5 j_i32 ;
:. jgei32	5b 'j' ca 'g' ca 'e' ca sp4 j_i32 ;
:. jlei32	5b 'j' ca 'l' ca 'e' ca sp4 j_i32 ;
:. jgi32	5b 'j' ca 'g' ca sp5 j_i32 ;

\ Register 0F long jump handlers in op0f table
jbi32  ' op0f $82 8* + !
jaei32 ' op0f $83 8* + !
jzi32  ' op0f $84 8* + !
jnzi32 ' op0f $85 8* + !
jbei32 ' op0f $86 8* + !
jai32  ' op0f $87 8* + !
jsi32  ' op0f $88 8* + !
jli32  ' op0f $8c 8* + !
jgei32 ' op0f $8d 8* + !
jlei32 ' op0f $8e 8* + !
jgi32  ' op0f $8f 8* + !

\ --- Test/Exchange --- (mne4: 0=test 1=xchg)
$84 :. test8	2b 0 m4 mr8 0 ;op
$85 :. test	2b 0 m4 mr 0 ;op
$86 :. xchg8	2b 1 m4 rm8 0 ;op
$87 :. xchg	2b 1 m4 rm 0 ;op

\ --- Mov --- (mne3: 0=mov 1=lea)
$88 $1000 :. mov8	xx 2b 0 m3 mr8 0 ;op
$89 $1001 :. mov	xx 2b 0 m3 mr 0 ;op
$8b $1002 :. mov.	xx 2b 0 m3 rm 0 ;op
$8d $1003 :. lea	xx 2b 1 m3 rm 0 ;op

\ --- Nop --- (mne3: 7=nop)
$90 :. nop	1b 7 m3. 0 ;op

\ --- setcc (0F 9x) — sub-handlers for op0f table ---
:. set__	split nip mod8 0 ;
:. setb		2b 's' ca 'e' ca 't' ca 'b' ca sp3 set__ ;
:. setae	2b 's' ca 'e' ca 't' ca 'a' ca 'e' ca sp2 set__ ;
:. setz		2b 's' ca 'e' ca 't' ca 'z' ca sp3 set__ ;
:. setnz	2b 's' ca 'e' ca 't' ca 'n' ca 'z' ca sp2 set__ ;
:. setbe	2b 's' ca 'e' ca 't' ca 'b' ca 'e' ca sp2 set__ ;
:. seta		2b 's' ca 'e' ca 't' ca 'a' ca sp3 set__ ;
:. setl		2b 's' ca 'e' ca 't' ca 'l' ca sp3 set__ ;
:. setge	2b 's' ca 'e' ca 't' ca 'g' ca 'e' ca sp2 set__ ;
:. setle	2b 's' ca 'e' ca 't' ca 'l' ca 'e' ca sp2 set__ ;
:. setg		2b 's' ca 'e' ca 't' ca 'g' ca sp3 set__ ;

setb   ' op0f $92 8* + !
setae  ' op0f $93 8* + !
setz   ' op0f $94 8* + !
setnz  ' op0f $95 8* + !
setbe  ' op0f $96 8* + !
seta   ' op0f $97 8* + !
setl   ' op0f $9c 8* + !
setge  ' op0f $9d 8* + !
setle  ' op0f $9e 8* + !
setg   ' op0f $9f 8* + !

\ --- CDQ/CQO --- (mne3: 8=cqo 9=cdq)
:. _cqo	1b 8 m3. 0 ;
:. _cdq	1b 9 m3. 0 ;
$99 :. cdq	rexW? 0<> IF _cqo ;THEN _cdq ;op

\ --- movzx/movsx (0F B6/B7/BE/BF) — sub-handlers for op0f ---
:. mov_x	split 0 CASE r64r ,byte r@ 0 ;THEN 3 CASE r64r ,a r8 0 ;THEN 2drop drop ??? 0 ;
:. movzx	2b 0 m5 mov_x ;
:. movsxi8	2b 1 m5 mov_x ;
movzx    ' op0f $b6 8* + !
:. movzxi16	2b 0 m5 split 0- drop 0<> IF 2drop ??? 0 ;THEN r64r ,word r@ 0 ;
movzxi16 ' op0f $b7 8* + !
movsxi8  ' op0f $be 8* + !
:. movsxi16	2b 1 m5 split 0- drop 0<> IF 2drop ??? 0 ;THEN r64r ,word r@ 0 ;
movsxi16 ' op0f $bf 8* + !

\ --- Mov immediate (avoid IF/ELSE/THEN: split into 64-bit and 32-bit helpers) ---
:. _movi64	.Q xa 0 ;
:. _movi32	.N xa 0 ;
$b8 :. movAi	1b 0 m3 rexW? 0<> IF 0 3 regs64 reg ,a _movi64 ;THEN 0 3 regs32 reg ,a _movi32 ;op
$b9 :. movCi	1b 0 m3 rexW? 0<> IF 1 3 regs64 reg ,a _movi64 ;THEN 1 3 regs32 reg ,a _movi32 ;op
$ba :. movDi	1b 0 m3 rexW? 0<> IF 2 3 regs64 reg ,a _movi64 ;THEN 2 3 regs32 reg ,a _movi32 ;op
$bb :. movBi	1b 0 m3 rexW? 0<> IF 3 3 regs64 reg ,a _movi64 ;THEN 3 3 regs32 reg ,a _movi32 ;op
$bd :. movBPi	1b 0 m3 rexW? 0<> IF 5 3 regs64 reg ,a _movi64 ;THEN 5 3 regs32 reg ,a _movi32 ;op

\ --- Shift/Rotate --- (mne3: 10=shl 11=shr 12=sar)
:. _shl_nm 4 CASE 10 ;THEN 5 CASE 11 ;THEN 7 CASE 12 ;THEN 2drop ??? 0 rdrop ;
$c1 :. shl	3b ext _shl_nm m3 7& r64 ,a xa 0 ;op
:. _shl1_nm 4 CASE 10 ;THEN 7 CASE 12 ;THEN 2drop ??? 0 rdrop ;
$d1 :. shl1	2b ext _shl1_nm m3 7& r64 ,1 0 ;op
:. _shcl_nm 4 CASE 10 ;THEN 5 CASE 11 ;THEN 2drop ??? 0 rdrop ;
$d3 :. sh_cl	2b ext _shcl_nm m3 7& r64 ,cl 0 ;op

\ --- Ret --- (mne3: 4=ret)
$c3 :. ret	1b 4 m3. -1 ;op

\ --- Mov immediate to r/m ---
$c6 :. movi8	2b 0 m3 'b' ca 'y' ca 't' ca 'e' ca split nip mod ,a dup cs@ dup space .b xa 1+ 0 ;op
$c7 :. movi32	2b 0 m3 split nip mod ,a space .le dup d@ xa 4+ 0 ;op

\ --- Word prefix ---
$66 :. 66	dup 1+ c@ $89 CASE 2b 0 m3 'w' ca 'o' ca 'r' ca 'd' ca drop mr 0 ;; ;THEN 2drop drop .A? 0 ;op

\ --- Call/Jmp --- (mne4: 2=call, mne3: 2=jmp)
$e8 :. call	5b 2 m4 over+ dup jba drop 0 ;op
$e9 :. jmpE9	5b 2 m3 over+ dup jba drop -1 ;op
$eb :. jmp	2b 2 m3 se over+ dup jba drop -1 ;op

\ --- Rep prefix ---
create repnms pvt 15 allot "movsbcmpsbstosb" repnms swap move
:. repn	5* repnms+ 5 ba ;
$f3 :. rep	2b
	$a4 CASE 'r' ca 'e' ca 'p' ca sp4 0 repn 0 ;; ;THEN
	$a6 CASE 'r' ca 'e' ca 'p' ca 'z' ca sp3 1 repn 0 ;; ;THEN
	$aa CASE 'r' ca 'e' ca 'p' ca sp4 2 repn 0 ;; ;THEN
	2drop drop ??? 0 ;op

\ --- Group 3: test/not/neg/mul/div ---
create f7exts pvt 32 allot "testtestnot neg mul imuldiv idiv" f7exts swap move
$f7 :. f7	2b split swap 4* f7exts+ 4 ba sp3 mod 0 ;op

\ --- Misc --- (mne3: 9=cld 5=std)
$fc :. cld	1b 9 m3. 0 ;op
$fd :. std	1b 5 m3. 0 ;op
create ffexts pvt 20 allot "inc dec calljmp push" ffexts swap move
:. ffn	4* ffexts+ 4 ba sp3 mod 0 ;
$ff :. ff	2b split swap
	0 CASE 0 ffn ;; ;THEN
	1 CASE 1 ffn ;; ;THEN
	2 CASE 2 ffn ;; ;THEN
	4 CASE 3 ffn ;; ;THEN
	6 CASE 4 ffn ;; ;THEN
	2drop drop ??? 0 ;op

\ --- Entry point ---
: see`		wsparse 0- 0= IF 2drop ;THEN 2dup findxt drop -rot type cr see. ;

hidepvt " see" features append ;
