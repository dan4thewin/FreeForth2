( exp 139: Prove eval works for file loading like i386's needed )
( Tests that eval compiles definitions from a file buffer, )
( that they persist after eval returns, and that nested/sequential )
( loads work correctly. )
( Uses tp@ as read target — the i386 pattern where tib is a file stack. )

( evalload: open file, read into tp@, close, eval )
( addr len -- )
: evalload openr dup tp@ 60000 rot read swap close drop tp@ swap eval ;

( === Test 1: Load a single file via eval, call defined word === )
"exp/139-eval-fileload/file1.ff" evalload
hello 42 - 0- 0= IF ."PASS:_eval-single" cr ;THEN ."FAIL:_eval-single" cr ;

( === Test 2: Load two files sequentially === )
"exp/139-eval-fileload/file2.ff" evalload
hello answer + 141 - 0- 0= IF ."PASS:_eval-sequential" cr ;THEN ."FAIL:_eval-sequential" cr ;

( === Test 3: Define a word that calls an eval-loaded definition === )
: use_hello hello 1+ ;
use_hello 43 - 0- 0= IF ."PASS:_eval-use-loaded" cr ;THEN ."FAIL:_eval-use-loaded" cr ;

( === Test 4: Nested eval — file4.ff calls evalload inside eval === )
"exp/139-eval-fileload/file4.ff" evalload
combined 141 - 0- 0= IF ."PASS:_eval-nested" cr ;THEN ."FAIL:_eval-nested" cr ;

( === Test 5: All definitions persist after multiple evals === )
hello answer combined + + 282 - 0- 0= IF ."PASS:_eval-persist" cr ;THEN ."FAIL:_eval-persist" cr ;

0 exit ;
