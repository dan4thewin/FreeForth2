\ test.ff — test ffpath template lookup (standalone, no needs)
variable _pass variable _fail
:. _ok 1 _pass +! ."." ;
:. _bad 1 _fail +! ."F" ;
:. _check 0- 0< IF _bad ;THEN close drop _ok ;
:. _notfound 0- 0< IF _ok ;THEN close drop _bad ;

"pno" openlib2 _check
"pno.ff" openlib2 _check
"test.ff" openlib2 _check
"shell.ff" openlib2 _check
"see.ff" openlib2 _check
"nosuchfile" openlib2 _notfound

_fail @ 0- 0= IF ."_ok" ELSE cr ."FAIL" cr THEN cr
; bye
