\ fileio.ff — file I/O tests (openr, openw, read, write, close, lseek)
\ Every test uses tell to cross-check that I/O actually happened.
\ No test can pass via trivial stack juggling alone.
needs shell.ff
needs fileops.ff
needs test.ff
9 >plan

variable _fd
create _buf 64 allot

\ --- openr / close ---

testing openr nonexistent returns -ENOENT
t{ "no_such_file_xyz" openr -> -2 }t

testing openr valid file, tell is zero, close returns zero
: _t1 "ff64.asm" openr _fd ! _fd @ tell _fd @ close ;
t{ _t1 -> 0 0 }t

\ --- read, verified by tell and content ---
\ ff64.asm begins with ";;; ff64.a" = $3B $3B $3B $20 $66 $66 ...

testing read: tell advances and content is correct
: _t2 "ff64.asm" openr _fd !
  _buf 4 _fd @ read   \ should return 4
  _fd @ tell           \ should be 4
  _fd @ close drop
  _buf c@ _buf 3+ c@ ; \ $3B (';') and $20 (' ')
t{ _t2 -> 4 4 $3B $20 }t

\ --- lseek, verified by tell and content ---

testing lseek: tell confirms position, read confirms content
\ byte 4 is $66 ('f'), byte 5 is $66 ('f')
: _t3 "ff64.asm" openr _fd !
  0 4 _fd @ lseek drop  \ seek to offset 4
  _fd @ tell             \ should be 4
  _buf 2 _fd @ read     \ should return 2
  _fd @ tell             \ should be 6
  _fd @ close drop
  _buf c@ _buf 1+ c@ ;  \ $66 $66 ('ff')
t{ _t3 -> 4 2 6 $66 $66 }t

\ --- write / read round-trip, verified by tell and content ---

!! rm -f ,test-io-tmp

testing write: tell advances by bytes written
: _t4 ",test-io-tmp" openw0 _fd !
  "hello" drop 5 _fd @ write  \ should return 5
  _fd @ tell                   \ should be 5
  _fd @ close drop ;
t{ _t4 -> 5 5 }t

testing read back: tell advances, content matches what was written
: _t5 ",test-io-tmp" openr _fd !
  _buf 5 _fd @ read  \ should return 5
  _fd @ tell          \ should be 5
  _fd @ close drop
  _buf c@ _buf 4+ c@ ;  \ $68 ('h') and $6F ('o')
t{ _t5 -> 5 5 $68 $6F }t

\ --- overwrite and verify new content ---

testing overwrite: new content replaces old
: _t6 ",test-io-tmp" openw0 _fd !
  "ABCDE" drop 5 _fd @ write drop
  _fd @ close drop
  ",test-io-tmp" openr _fd !
  _buf 5 _fd @ read  \ should return 5
  _fd @ tell          \ should be 5
  _fd @ close drop
  _buf c@ _buf 2+ c@ _buf 4+ c@ ;  \ $41 $43 $45 = A C E
t{ _t6 -> 5 5 $41 $43 $45 }t

\ --- lseek within written file ---

testing lseek in written file: seek, read, verify content
: _t7 ",test-io-tmp" openr _fd !
  0 2 _fd @ lseek drop  \ seek to offset 2
  _fd @ tell             \ should be 2
  _buf 1 _fd @ read     \ should return 1
  _fd @ close drop
  _buf c@ ;              \ $43 ('C')
t{ _t7 -> 2 1 $43 }t

\ --- partial write then append ---

testing partial write, seek to start, read all
: _t8 ",test-io-tmp" openw0 _fd !
  "XY" drop 2 _fd @ write drop  \ write 2 bytes
  _fd @ tell                     \ should be 2
  0 0 _fd @ lseek drop          \ seek back to 0
  _fd @ tell                     \ should be 0
  _buf 2 _fd @ read drop        \ read them back
  _fd @ close drop
  _buf c@ _buf 1+ c@ ;          \ $58 $59 = X Y
t{ _t8 -> 2 0 $58 $59 }t

!! rm -f ,test-io-tmp

tally-exit ;

