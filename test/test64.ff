\ test64.ff — consolidated regression tests for ff64
\ Uses lib/x86-64/test.ff framework: t{ actual -> expected }t
\ Run: ./ff64 ': prompt ;' -f test/test64.ff

needs test.ff
196 >plan

\ ============================================================
\ Stack operations (from exp 023, 028, 091)
\ ============================================================

testing dup
t{ 42 dup -> 42 42 }t

testing drop
t{ 10 20 drop -> 10 }t

testing over
t{ 10 20 over -> 10 20 10 }t

testing swap
t{ 10 20 swap -> 20 10 }t

testing nip
t{ 10 20 nip -> 20 }t

testing tuck
t{ 10 20 tuck -> 20 10 20 }t

testing 2dup
t{ 10 20 2dup -> 10 20 10 20 }t

testing 2drop
t{ 10 20 30 40 2drop -> 10 20 }t

testing rot
t{ 1 2 3 rot -> 2 3 1 }t

testing -rot
t{ 1 2 3 -rot -> 3 1 2 }t

testing rot -rot identity
t{ 1 2 3 rot -rot -> 1 2 3 }t

testing 2xchg
t{ 10 20 30 2xchg -> 30 20 10 }t

testing 3dup
t{ 10 20 30 3dup -> 10 20 30 10 20 30 }t

testing ?dup nonzero
t{ 5 ?dup -> 5 5 }t

testing ?dup zero
t{ 0 ?dup -> 0 }t

testing negate
t{ 5 negate -> -5 }t
t{ -3 negate -> 3 }t
t{ 0 negate -> 0 }t

\ ============================================================
\ Memory operations (from exp 024, 025, 091)
\ ============================================================

testing variable ! @
variable tv1
t{ 42 tv1 ! tv1 @ -> 42 }t

testing c! c@
variable tv2
t{ 65 tv2 c! tv2 c@ -> 65 }t

testing +!
variable tv3
t{ 10 tv3 ! 32 tv3 +! tv3 @ -> 42 }t

testing -!
variable tv4
t{ 50 tv4 ! 8 tv4 -! tv4 @ -> 42 }t

testing cs@ sign extension
variable tv5
t{ 255 tv5 c! tv5 cs@ -> -1 }t
t{ 127 tv5 c! tv5 cs@ -> 127 }t
t{ 128 tv5 c! tv5 cs@ -> -128 }t

testing w@ ws@
variable tv6
t{ 4660 tv6 ! tv6 w@ -> 4660 }t
t{ 65535 tv6 ! tv6 ws@ -> -1 }t

testing w! 2dupw!
t{ 0 tv6 ! $ABCD tv6 w! tv6 w@ -> $ABCD }t
t{ $DEADBEEF'CAFE0000 tv6 ! $0102 tv6 w! tv6 @ -> $DEADBEEF'CAFE0102 }t
\ 2dupw! preserves both operands (note stack order: value below, addr on top)
t{ 0 tv6 ! $5678 tv6 2dupw! -> $5678 tv6 }t
t{ 0 tv6 ! $5678 tv6 2dupw! 2drop tv6 w@ -> $5678 }t

testing w! no clobber
\ verify w! writes exactly 2 bytes, not 8 (regression: REX.W override bug)
create _twbuf 8 allot
t{ _twbuf 8 $AA fill $2031 _twbuf 3+ w! _twbuf 5+ c@ -> $AA }t
t{ _twbuf 3+ c@ -> $31 }t
t{ _twbuf 4+ c@ -> $20 }t

testing dup@ dupc@ dupw@
variable tv7
t{ 42 tv7 ! tv7 dup@ -> tv7 42 }t
t{ 171 tv7 ! tv7 dupc@ -> tv7 171 }t
t{ 4660 tv7 ! tv7 dupw@ -> tv7 4660 }t

testing d! d@
variable tv8
t{ 42 tv8 d! tv8 d@ -> 42 }t
t{ -1 tv8 d! tv8 d@ -> -1 }t
t{ $7FFFFFFF tv8 d! tv8 d@ -> $7FFFFFFF }t

\ ============================================================
\ Literals (from exp 026)
\ ============================================================

testing byte literal
: _tlit42` 42 lit` ;
t{ _tlit42 -> 42 }t

testing 32-bit literal
: _tlit1M` 1000000 lit` ;
t{ _tlit1M -> 1000000 }t

testing 64-bit literal
: _tlit4G` 4294967296 lit` ;
t{ _tlit4G -> 4294967296 }t

testing negative literal
: _tlitn1` -1 lit` ;
t{ _tlitn1 -> -1 }t

testing zero literal
: _tlit0` 0 lit` ;
t{ _tlit0 -> 0 }t

testing on off
variable tv9
t{ 42 tv9 ! tv9 off tv9 @ -> 0 }t
t{ tv9 on tv9 @ -> -1 }t

\ ============================================================
\ Compilation: c, w, , here (from exp 027)
\ ============================================================

testing c, advance
t{ here 65 c, here swap - -> 1 }t

testing c, value
t{ here 65 c, c@ -> 65 }t

testing w, advance
t{ here 4660 w, here swap - -> 2 }t

testing w, value
t{ here 4660 w, w@ -> 4660 }t

testing , advance
t{ here 42 , here swap - -> 8 }t

testing , value
t{ here 42 , @ -> 42 }t

\ ============================================================
\ Arithmetic (from exp 029, 030, 091)
\ ============================================================

testing + - *
t{ 3 7 + -> 10 }t
t{ 10 3 - -> 7 }t
t{ 6 7 * -> 42 }t

testing 2* 2/
t{ 25 2* -> 50 }t
t{ 50 2/ -> 25 }t
t{ -7 2/ -> -4 }t

testing 4+ 4* 4/
t{ 100 4+ -> 104 }t
t{ 10 4* -> 40 }t
t{ 40 4/ -> 10 }t

testing 8+ 8- 8*
t{ 100 8+ -> 108 }t
t{ 108 8- -> 100 }t
t{ 5 8* -> 40 }t

testing m/mod
t{ 10 0 3 m/mod -> 1 3 }t
t{ -10 -1 3 m/mod -> -1 -3 }t
t{ 12 0 4 m/mod -> 0 3 }t

testing um/mod
t{ 10 0 3 um/mod -> 1 3 }t

testing m*
t{ 5 7 m* -> 35 0 }t

testing /% / %
t{ 17 5 /% -> 2 3 }t
t{ 70 5 / -> 14 }t
t{ 17 5 % -> 2 }t

testing */mod */
t{ 10 3 7 */mod -> 2 4 }t
t{ 10 6 3 */ -> 20 }t

testing abs
t{ -5 abs -> 5 }t
t{ 5 abs -> 5 }t
t{ 0 abs -> 0 }t

testing min max
t{ 3 7 min -> 3 }t
t{ 7 3 min -> 3 }t
t{ 3 7 max -> 7 }t
t{ 7 3 max -> 7 }t

\ ============================================================
\ Shifts (from exp 043)
\ ============================================================

testing << >>
t{ 1 3 << -> 8 }t
t{ 200 3 >> -> 25 }t
t{ 5 1 << -> 10 }t
t{ 42 0 << -> 42 }t

testing << 64-bit
t{ 1 32 << -> $100000000 }t

testing bswap
t{ 1 bswap -> 72057594037927936 }t

\ ============================================================
\ Comparisons (from exp 032, 092)
\ FreeForth comparisons set FLAGS, do NOT consume operands.
\ BOOL converts FLAGS to stack boolean, pushed on top.
\ ============================================================

testing 0= BOOL
t{ 0 0- 0= BOOL nip -> -1 }t
t{ 5 0- 0= BOOL nip -> 0 }t

testing 0<> BOOL
t{ 5 0- 0<> BOOL nip -> -1 }t
t{ 0 0- 0<> BOOL nip -> 0 }t

testing 0< BOOL
t{ -1 0- 0< BOOL nip -> -1 }t
t{ 5 0- 0< BOOL nip -> 0 }t

testing 0> BOOL
t{ 5 0- 0> BOOL nip -> -1 }t
t{ -1 0- 0> BOOL nip -> 0 }t

testing = <> < > via IF
: _teq = 2drop IF 1 ;THEN 0 ;
: _tne <> 2drop IF 1 ;THEN 0 ;
: _tlt < 2drop IF 1 ;THEN 0 ;
: _tgt > 2drop IF 1 ;THEN 0 ;
t{ 5 5 _teq -> 1 }t
t{ 5 3 _teq -> 0 }t
t{ 5 3 _tne -> 1 }t
t{ 3 5 _tlt -> 1 }t
t{ 5 3 _tgt -> 1 }t

testing <= >= u< u> via IF
: _tle <= 2drop IF 1 ;THEN 0 ;
: _tge >= 2drop IF 1 ;THEN 0 ;
: _tult u< 2drop IF 1 ;THEN 0 ;
: _tugt u> 2drop IF 1 ;THEN 0 ;
t{ 3 5 _tle -> 1 }t
t{ 5 5 _tle -> 1 }t
t{ 5 3 _tge -> 1 }t
t{ 3 3 _tge -> 1 }t
t{ 3 5 _tult -> 1 }t
t{ 5 3 _tugt -> 1 }t

\ ============================================================
\ Flow control (from exp 031, 036, 037, 044, 050, 070)
\ ============================================================

testing IF/THEN
: _tif1 0- 0= drop IF 42 ;THEN 99 ;
t{ 0 _tif1 -> 42 }t
t{ 5 _tif1 -> 99 }t

testing IF/ELSE/THEN
: _tif2 0- 0= drop IF 42 ELSE 99 THEN ;
t{ 0 _tif2 -> 42 }t
t{ 5 _tif2 -> 99 }t

testing BEGIN/UNTIL
: _tbu BEGIN 1 - dup 0- 0= drop UNTIL ;
t{ 5 _tbu -> 0 }t

testing BEGIN/WHILE/REPEAT
: _tbw BEGIN dup 0- 0> drop WHILE 1 - REPEAT ;
t{ 5 _tbw -> 0 }t

testing nested IF
: _tnif dup 0- 0> drop IF 10 > 2drop IF 99 ELSE 42 THEN ELSE drop 0 THEN ;
t{ 5 _tnif -> 42 }t
t{ 15 _tnif -> 99 }t
t{ -1 _tnif -> 0 }t

testing ;THEN early exit
: _tsemi dup 0- 0= drop IF drop 42 ;THEN ;
t{ 0 _tsemi -> 42 }t
t{ 5 _tsemi -> 5 }t

testing 0; early exit
: _t0semi 0; drop 99 ;
t{ 0 _t0semi -> }t
t{ 5 _t0semi -> 99 }t

testing ;; mid-definition return
: _tsemisemi 42 ;; 99 ;
t{ _tsemisemi -> 42 }t

testing 0<>; early exit
: _t0nesemi 0<>; 99 nip ;
t{ 5 _t0nesemi -> }t
t{ 0 _t0nesemi -> 99 }t

testing TIMES/REPEAT
: _ttl1 0 swap TIMES 1 + REPEAT ;
t{ 1 _ttl1 -> 1 }t
t{ 5 _ttl1 -> 5 }t
t{ 0 _ttl1 -> 0 }t

testing TIMES r counter
: _ttlr 0 5 TIMES r + REPEAT ;
t{ _ttlr -> 10 }t

testing nested TIMES
: _ttln 0 3 TIMES 2 TIMES 1 + REPEAT REPEAT ;
t{ _ttln -> 6 }t

testing TIMES/REPEAT
: _ttr 0 3 TIMES 1 + REPEAT ;
t{ _ttr -> 3 }t

testing RTIMES
: _trtimes 0 5 >r RTIMES r + REPEAT ;
t{ _trtimes -> 10 }t

testing START/END
\ START without ENTER is single-pass (no backward jump in END)
: _tse 5 START 1- dup 0- 0= IF BREAK drop END drop ;
t{ _tse -> }t

testing START/BREAK single-pass
: _tsb 0 START dup 5 = 2drop IF BREAK 1+ END ;
t{ _tsb -> 1 }t

testing CASE
: _tcase 1 CASE 10 ;THEN 2 CASE 20 ;THEN drop 99 ;
t{ 1 _tcase -> 10 }t
t{ 2 _tcase -> 20 }t
t{ 7 _tcase -> 99 }t
testing BEGIN/CASE/BREAK/END
: _tcase2 BEGIN 1 CASE 10 BREAK 2 CASE 20 BREAK drop 99 END ;
t{ 1 _tcase2 -> 10 }t
t{ 2 _tcase2 -> 20 }t
t{ 7 _tcase2 -> 99 }t

\ ============================================================
\ Conditional compilation (from exp 056)
\ ============================================================

testing [IF] true
: _tcif1 [1] [IF] 42 [THEN] ;
t{ _tcif1 -> 42 }t

testing [IF] [ELSE]
: _tcif2 [0] [IF] 42 [ELSE] 99 [THEN] ;
t{ _tcif2 -> 99 }t

\ ============================================================
\ Dot conditionals (from exp 057)
\ ============================================================

testing IF. true
: _tdif1 -1 IF. 42 ;THEN 99 ;
t{ _tdif1 -> 42 }t

testing IF. false
: _tdif2 0 IF. 42 ;THEN 99 ;
t{ _tdif2 -> 99 }t

testing WHILE. loop
: _tdwh 5 BEGIN dup WHILE. 1 - REPEAT ;
t{ _tdwh -> 0 }t

testing UNTIL. loop
: _tdul 5 BEGIN 1 - dup 0- 0= BOOL nip UNTIL. ;
t{ _tdul -> 0 }t

