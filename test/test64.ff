\ Variables and marker (from exp 045, 090)
\ ============================================================

testing variable init zero
variable _tvz
t{ _tvz @ -> 0 }t

testing create allot
create _tbuf 16 allot
t{ 42 _tbuf ! _tbuf @ -> 42 }t
t{ 99 _tbuf 8 + ! _tbuf 8 + @ -> 99 }t
t{ here 8 allot here swap - -> 8 }t

testing mark forgets
: _tmkword 77 ;
mark _tmk
: _tmkword 88 ;
_tmk
t{ _tmkword -> 77 }t

\ ============================================================
\ Return stack (from exp 024, 028)
\ ============================================================

testing >r r>
t{ 42 >r r> -> 42 }t

testing dup>r r>
t{ 42 dup>r r> -> 42 42 }t

testing 2r
: _t2r 10 >r 20 >r 2r rdrop rdrop ;
t{ _t2r -> 10 20 }t

testing rdrop
: _trdrop 10 >r 20 >r rdrop r> ;
t{ _trdrop -> 10 }t

\ ============================================================
\ Place and cmove (from exp 029)
\ ============================================================

create _tplace1 0 , 0 ,
create _tplace2 0 , 0 ,

testing cmove
t{ 65 _tplace1 c! 66 _tplace1 1 + c! 67 _tplace1 2 + c!
   _tplace1 _tplace2 3 cmove
   _tplace2 c@ _tplace2 1 + c@ _tplace2 2 + c@ -> 65 66 67 }t

\ ============================================================
\ Peephole: ++ -- (from exp 061)
\ ============================================================

\ ++ and -- are peephole macros — must follow fetch-suffix (foo@)
testing ++ increment
variable _tvinc
t{ 10 _tvinc ! _tvinc@ ++ _tvinc @ -> 11 }t

testing -- decrement
t{ 10 _tvinc ! _tvinc@ -- _tvinc @ -> 9 }t

\ ============================================================
\ Miscellaneous (from exp 059)
\ ============================================================

\ within returns FLAGS (nzTRUE/zFALSE) — use 0<> IF to branch
testing within
: _twith within 0<> IF 1 ;THEN 0 ;
t{ 5 3 8 _twith -> 1 }t
t{ 2 3 8 _twith -> 0 }t
t{ 3 3 8 _twith -> 1 }t
t{ 8 3 8 _twith -> 0 }t

testing s>d
t{ 5 s>d -> 5 0 }t
t{ -1 s>d -> -1 -1 }t

testing 2over
t{ 1 2 3 4 2over -> 1 2 3 4 1 2 }t

testing depth in word
: _tdep depth ;
t{ _tdep -> 0 }t
t{ 1 2 _tdep -rot 2drop -> 2 }t

