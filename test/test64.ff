testing $- equal strings
create _ts1 65 c, 66 c, 67 c,
create _ts2 65 c, 66 c, 67 c,
t{ _ts1 _ts2 3 $- -> 0 }t

testing $- different strings
create _ts3 65 c, 66 c, 68 c,
t{ _ts1 _ts3 3 $- -> -1 }t

