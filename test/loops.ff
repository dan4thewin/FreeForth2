\ Group Q: START/ENTER/UNTIL
\ ============================================================

\ ff.boot:275 — START 2dup+ 1+ -rot type space ENTER h.sz+ c@+ 0- 0= UNTIL
testing START/ENTER/UNTIL countdown
: _q1 5 START 1- ENTER 0- 0= UNTIL ;
t{ _q1 -> 0 }t

\ fflin.boot:34 — START ... IF ... THEN ... ENTER ... UNTIL
testing START/ENTER/UNTIL with IF/THEN
: _q2 0 5 START dup 3 = 2drop IF swap 10 + swap THEN 1-
  ENTER dup 0- 0= drop UNTIL drop ;
t{ _q2 -> 10 }t

\ ff.boot:265 — ;THEN inside START/ENTER/UNTIL
testing START/ENTER/UNTIL with ;THEN
: _q3 5 START dup 3 = 2drop IF ;THEN 1- ENTER 0- 0= UNTIL ;
t{ _q3 -> 3 }t

\ ============================================================
\ Group R: TIMES + WHILE early exit
\ ============================================================

\ hanoi:49 — TIMES tuck c@ <> drop swap 0<> WHILE 1+ REPEAT nip ;
testing TIMES + WHILE early exit (match)
: _r1 0 10 TIMES 1+ dup 3 <> 2drop WHILE REPEAT ;
t{ _r1 -> 3 }t

testing TIMES + WHILE early exit (no match — full TIMES)
: _r2 0 3 TIMES 1+ dup 99 <> 2drop WHILE REPEAT ;
t{ _r2 -> 3 }t

