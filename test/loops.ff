testing CASE/BREAK + UNTIL (match)
: _t1 0 BEGIN 1+ 3 CASE 30 BREAK dup 5 = 2drop UNTIL ;
t{ _t1 -> 30 }t

testing CASE/BREAK + UNTIL (no match, UNTIL exits)
: _t2 0 BEGIN 1+ 99 CASE -1 BREAK dup 3 = 2drop UNTIL ;
t{ _t2 -> 3 }t

\ ============================================================
\ Group U: Multiple WHILE
\ ============================================================

\ hanoi:58 — BEGIN 1- 0<> WHILE d b` 1- 0<> WHILE d c` 1- 0<> WHILE d a` REPEAT
testing double WHILE countdown
: _u1 10 BEGIN 1- 0- 0<> WHILE 1- 0- 0<> WHILE REPEAT ;
t{ _u1 -> 0 }t
testing triple WHILE countdown
: _u2 30 BEGIN 1- 0- 0<> WHILE 1- 0- 0<> WHILE 1- 0- 0<> WHILE REPEAT ;
t{ _u2 -> 0 }t

\ ============================================================
\ Group V: Nested START/ENTER
\ ============================================================

\ ff.boot:284 — nested START/ENTER in dump
\ hid-m.ff:4-6 — START ... START ... ENTER ... UNTIL ... ENTER ... UNTIL
testing nested START/ENTER/UNTIL
\ 3 START = 2 body passes (START skips first). 2 outer × 2 inner = 4.
: _v1 0 >r 3 START 3 START r> 1+ >r
  ENTER 1- dup 0- 0= drop UNTIL drop
  ENTER 1- dup 0- 0= drop UNTIL drop r> ;
t{ _v1 -> 4 }t

