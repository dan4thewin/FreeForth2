testing ;; in CASE/BREAK/END dispatch
: _s1 BEGIN 4 CASE 10 BREAK 7 CASE 20 BREAK drop 99 ;; END ;
t{ 4 _s1 -> 10 }t
t{ 7 _s1 -> 20 }t
t{ 3 _s1 -> 99 }t

\ ============================================================
