\ loops.ff — loop+conditional pattern test matrix
\ Cross-referenced with Lavarenne source code.
\ Uses t{ -> }t framework. REPEAT closes TIMES.
\
\ Stack discipline reminders:
\   = < > >= — set FLAGS, do NOT consume. 2drop both args after.
\   0- 0= 0> 0< 0<> — set FLAGS on TOS, do NOT consume. drop after.
\   r — pushes loop counter (new stack item). Must be consumed.
\   0; — if TOS==0: drop TOS, return. Else: continue (no consume).
\   ;THEN — ;; THEN. Returns from current word.
\   CASE — = drop IF drop. Match: both consumed. Miss: comparison consumed.
\   drop preserves FLAGS.

needs test.ff
91 >plan

\ ============================================================
\ Group A: Plain loops — sanity baseline
\ ============================================================

\ ff.boot: : words ... BEGIN ... 0<> UNTIL ... ;
testing BU: BEGIN/UNTIL countdown
: _a2 5 BEGIN 1- dup 0- 0= drop UNTIL ;
t{ _a2 -> 0 }t

\ fflin.boot: : _type BEGIN zlen 0<> WHILE 2dup+ -rot type cr 1+ REPEAT 2drop ;
testing BWR: BEGIN/WHILE/REPEAT countdown
: _a3 5 BEGIN dup 0- 0> drop WHILE 1- REPEAT ;
t{ _a3 -> 0 }t

\ ff.boot: : .# ... TIMES dup r 4* >> $F& .digit REPEAT drop ;
testing TR: TIMES/REPEAT sum
: _a4 0 5 TIMES 1+ REPEAT ;
t{ _a4 -> 5 }t

testing TR: TIMES r sum
: _a5 0 5 TIMES r + REPEAT ;
t{ _a5 -> 10 }t

\ hanoi:36-38 — triple nested TIMES
testing TR nested
: _a6 0 3 TIMES 2 TIMES 1+ REPEAT REPEAT ;
t{ _a6 -> 6 }t

\ see.ff: : nexth START h.sz+ c@+ + 1+ skip? 0<> WHILE ENTER stop? REPEAT ;
testing SE: START/ENTER/WHILE/REPEAT
: _a7 0 START 1+ ENTER 5 < drop WHILE REPEAT ;
t{ _a7 -> 5 }t

\ ff.boot: : RTIMES` >C1 BEGIN` ... ;
testing RT: RTIMES/REPEAT sum
: _a8 0 5 >r RTIMES r + REPEAT ;
t{ _a8 -> 10 }t

\ see.ff: BEGIN 4 CASE "shl" BREAK 7 CASE "sar" BREAK 2drop ??? 0 ;; END
testing BCBE: CASE dispatch
: _a9 BEGIN 1 CASE 10 BREAK 2 CASE 20 BREAK drop 99 END ;
t{ 1 _a9 -> 10 }t
t{ 2 _a9 -> 20 }t
t{ 7 _a9 -> 99 }t

\ ============================================================
\ Group B: IF/THEN in loops
\ ============================================================

\ hanoi:38 — IF ... THEN inside TIMES body
testing IF/THEN in BU
: _b2 0 5 BEGIN 1- dup 3 = 2drop IF 99 -rot THEN
  dup 0- 0= drop UNTIL 2drop ;
t{ _b2 -> 99 }t

testing IF/THEN in BWR
: _b3 0 5 BEGIN dup 0- 0> drop WHILE
  dup 3 = 2drop IF 99 -rot THEN 1- REPEAT 2drop ;
t{ _b3 -> 99 }t

\ ff.boot: ... r 4* >> $F& ... IF ... THEN ...
testing IF/THEN in TR
: _b4 0 5 TIMES r dup 3 = 2drop IF 10 + THEN + REPEAT ;
t{ _b4 -> 20 }t

testing IF/THEN in SE
: _b5 0 5 START dup 3 = 2drop IF 99 -rot THEN
  swap 1+ swap 1- ENTER 0- 0> WHILE REPEAT 2drop ;
t{ _b5 -> 99 }t

testing IF/THEN in RT
: _b6 0 5 >r RTIMES r dup 3 = 2drop IF 10 + THEN + REPEAT ;
t{ _b6 -> 20 }t

\ ============================================================
\ Group C: IF/ELSE/THEN in loops
\ ============================================================

\ hanoi:54 — u< IF drop c! drop ELSE nip nip c! THEN
testing IF/ELSE/THEN in TR
: _c1 0 5 TIMES r 2 > 2drop IF 10 ELSE 1 THEN + REPEAT ;
t{ _c1 -> 23 }t

testing IF/ELSE/THEN in BWR (counter on rstack)
: _c2 0 5 BEGIN dup 0- 0> drop WHILE >r
  r 2 > 2drop IF 10 ELSE 1 THEN + r> 1- REPEAT drop ;
t{ _c2 -> 32 }t

testing IF/ELSE/THEN in BU (counter on rstack)
: _c3 0 5 BEGIN >r r 2 > 2drop IF 10 ELSE 1 THEN + r> 1-
  dup 0- 0= drop UNTIL drop ;
t{ _c3 -> 32 }t

testing IF/ELSE/THEN in BWR simple
: _c5 3 BEGIN dup 0- 0> drop WHILE
  dup 2 = 2drop IF 10 ELSE 20 THEN . cr 1- REPEAT drop ;
t{ _c5 -> }t

\ ============================================================
\ Group D: ;THEN (early return from word)
\ ============================================================

\ ff.boot:228 — BEGIN _[] 0<> UNTIL _[] ;THEN 1+ THEN drop ;
testing ;THEN baseline
: _d0 dup 0- 0= drop IF drop 42 ;THEN ;
t{ 0 _d0 -> 42 }t
t{ 5 _d0 -> 5 }t

testing ;THEN in BU
: _d2 5 BEGIN dup 3 = 2drop IF ;THEN 1- dup 0- 0= drop UNTIL ;
t{ _d2 -> 3 }t

testing ;THEN in BWR
: _d3 5 BEGIN dup 3 = 2drop IF ;THEN dup 0- 0> drop WHILE 1- REPEAT ;
t{ _d3 -> 3 }t

\ ff.boot:265 — rdrop ;THEN pattern in TIMES
testing ;THEN in TR (rdrop needed)
: _d4 10 TIMES r 7 = 2drop IF r rdrop ;THEN REPEAT -1 ;
t{ _d4 -> 7 }t

testing ;THEN in TR no match
: _d5 3 TIMES r 7 = 2drop IF r rdrop ;THEN REPEAT -1 ;
t{ _d5 -> -1 }t

testing ;THEN in SE
: _d6 5 START 1- dup 3 = 2drop IF ;THEN ENTER 0- 0> WHILE REPEAT ;
t{ _d6 -> 3 }t

testing ;THEN in RT (rdrop needed)
: _d7 5 >r RTIMES r 3 = 2drop IF r rdrop ;THEN REPEAT -1 ;
t{ _d7 -> 3 }t

\ ============================================================
\ Group E: 0; (return if TOS==0, dropping the zero)
\ ============================================================

\ ff.boot: : 0;` 0-` 0=` IF` drop` ;THEN` ;
testing 0; baseline
: _e0 0; drop 99 ;
t{ 0 _e0 -> }t
t{ 5 _e0 -> 99 }t

\ ff.boot: : 0; ... ; (recursive usage in .#s etc.)
testing 0; recursive (classic pattern)
: _e1 0; dup 1- _e1 ;
t{ 3 _e1 -> 3 2 1 }t

\ test.ff:28 — chkvals: BEGIN depth 0; dropr> <> ...
testing 0; in BWR (condition after 0;)
: _e4 3 BEGIN dup 0; drop dup 0- 0> drop WHILE 1- REPEAT ;
t{ _e4 -> 0 }t

testing 0; in BU (condition after 0;)
: _e5 3 BEGIN dup 0; drop 1- dup 0- 0= drop UNTIL ;
t{ _e5 -> 0 }t

\ ============================================================
\ Group F: 0<>; (return if TOS nonzero)
\ ============================================================

\ ff.boot: : 0<>;` 0-` 0<>` IF` ;THEN` ;
testing 0<>; baseline
: _f0 0<>; 99 nip ;
t{ 5 _f0 -> }t
t{ 0 _f0 -> 99 }t

\ ============================================================
\ Group G: ;; (unconditional early return)
\ ============================================================

testing ;; baseline
: _g0 42 ;; 99 ;
t{ _g0 -> 42 }t

\ see.ff:237 — ;; as fallthrough exit in CASE/BREAK/END
testing ;; in BWR
: _g1 5 BEGIN dup 0- 0> drop WHILE
  dup 3 = 2drop IF drop 99 ;; THEN 1- REPEAT ;
t{ _g1 -> 99 }t

testing ;; in BU
: _g2 5 BEGIN dup 3 = 2drop IF drop 99 ;; THEN
  1- dup 0- 0= drop UNTIL ;
t{ _g2 -> 99 }t


\ ============================================================
\ Group H: IF AGAIN — conditional restart (no THEN)
\ debug.ff: BEGIN wsparse ... 0= IF ct AGAIN  ... REPEAT
\ ============================================================

\ count how many times counter equals 3 during 5→0 countdown
\ IF body: increment accumulator, decrement counter, restart loop
testing IF AGAIN in BWR
: _h1 0 5 BEGIN dup 0- 0> drop WHILE
  dup 3 = 2drop IF swap 1+ swap 1- AGAIN 1- REPEAT drop ;
t{ _h1 -> 1 }t

\ same pattern with BEGIN/UNTIL
testing IF AGAIN in BU
: _h2 0 5 BEGIN dup 3 = 2drop IF swap 1+ swap 1-
  AGAIN 1- dup 0- 0= drop UNTIL drop ;
t{ _h2 -> 1 }t

\ ============================================================
\ Group I: BREAK / IF BREAK / dispatch
\ ============================================================

\ fflin.boot: BEGIN zlen 0- 0= IF BREAK 2dup+ 1+ >r _getenv r> REPEAT
testing IF BREAK in BWR
: _i2 10 BEGIN 1- dup 5 = 2drop IF BREAK dup 0- 0> drop WHILE REPEAT ;
t{ _i2 -> 5 }t

\ test.ff:28 — chkvals: BEGIN depth 0; dropr> <> 2drop IF depth +r BREAK REPEAT
\ BEGIN...IF BREAK...REPEAT without WHILE
testing IF BREAK in BR (no WHILE)
: _i2b 0 BEGIN dup 9 > 2drop IF BREAK 1+ REPEAT ;
t{ _i2b -> 10 }t

\ fpu.ff:156 — CASE...BREAK inside BEGIN/UNTIL
testing IF BREAK in BU + END
: _i3 0 BEGIN 1+ dup 3 = 2drop IF BREAK dup 10 = 2drop UNTIL ;
t{ _i3 -> 3 }t

\ ff.boot:265 — rdrop ;THEN for early exit from TIMES
testing IF rdrop ;THEN in TR (early exit)
: _i4 -1 10 TIMES r 5 = 2drop IF drop r rdrop ;THEN REPEAT ;
t{ _i4 -> 5 }t

testing IF rdrop ;THEN in TR (no match)
: _i4b -1 3 TIMES r 5 = 2drop IF drop r rdrop ;THEN REPEAT ;
t{ _i4b -> -1 }t

\ see.ff:102,115 — chained ;THEN dispatch (no loop)
testing dispatch with ;THEN
: _i5 dup 1 = 2drop IF drop 10 ;THEN
  dup 2 = 2drop IF drop 20 ;THEN drop 99 ;
t{ 1 _i5 -> 10 }t
t{ 2 _i5 -> 20 }t
t{ 7 _i5 -> 99 }t

\ ============================================================
\ Group J: >r..r> inside loops
\ ============================================================

\ fflin.boot:22 — >r ... r> around loop body
testing >r..r> in BWR
: _j1 0 5 BEGIN dup 0- 0> drop WHILE >r 1+ r> 1- REPEAT drop ;
t{ _j1 -> 5 }t

testing >r..r> in BU
: _j2 0 5 BEGIN >r 1+ r> 1- dup 0- 0= drop UNTIL drop ;
t{ _j2 -> 5 }t

testing >r outside TR
: _j4 42 >r 0 5 TIMES 1+ REPEAT r> + ;
t{ _j4 -> 47 }t

\ ============================================================
\ Group K: helper with ;THEN (non-inline :)
\ ============================================================

testing helper ;THEN baseline
: _kh 3 = drop IF drop 99 ;THEN ;
t{ 3 _kh -> 99 }t
t{ 5 _kh -> 5 }t

testing helper ;THEN from BWR
: _k1 5 BEGIN dup 0- 0> drop WHILE dup _kh drop 1- REPEAT ;
t{ _k1 -> 0 }t

testing helper ;THEN from BU
: _k2 5 BEGIN dup _kh drop 1- dup 0- 0= drop UNTIL ;
t{ _k2 -> 0 }t

\ r=4→4, r=3→99, r=2→2, r=1→1, r=0→0. Sum=106
testing helper ;THEN from TR (sum)
: _k4 0 5 TIMES r _kh + REPEAT ;
t{ _k4 -> 106 }t

testing helper multi-;THEN baseline
: _k5h 1 = drop IF drop 10 ;THEN
  2 = drop IF drop 20 ;THEN
  3 = drop IF drop 30 ;THEN ;
t{ 1 _k5h -> 10 }t
t{ 2 _k5h -> 20 }t
t{ 3 _k5h -> 30 }t
t{ 5 _k5h -> 5 }t

\ r=4→4, r=3→30, r=2→20, r=1→10, r=0→0. Sum=64
testing multi-;THEN helper from TR
: _k6 0 5 TIMES r _k5h + REPEAT ;
t{ _k6 -> 64 }t

\ ============================================================
\ Group L: inline helper with ;THEN (:.)
\ ============================================================

testing inline helper ;THEN baseline
:. _lh 3 = drop IF drop 99 ;THEN ;
t{ 3 _lh -> 99 }t
t{ 5 _lh -> 5 }t

testing inline ;THEN from BWR
: _l1 5 BEGIN dup 0- 0> drop WHILE dup _lh drop 1- REPEAT ;
t{ _l1 -> 0 }t

testing inline ;THEN from TR
: _l2 0 5 TIMES r _lh + REPEAT ;
t{ _l2 -> 106 }t

\ ============================================================
\ Group M: exit-thru-caller (2rdrop rdrop ;THEN)
\ KNOWN BUG: rdrop ;THEN segfaults during compilation.
\ ============================================================

\ :. _nh over = 2drop IF drop 99 2rdrop rdrop ;THEN ;

\ ============================================================
\ Group N: nested loops
\ ============================================================

\ ff.boot:284-286 — nested START/ENTER inside words/dump
testing nested BWR in BWR
: _n1 0 3 BEGIN dup 0- 0> drop WHILE
  swap 3 BEGIN dup 0- 0> drop WHILE swap 1+ swap 1- REPEAT drop
  swap 1- REPEAT drop ;
t{ _n1 -> 9 }t

\ hanoi:36-38 — triple nested TIMES
testing nested TR in TR
: _n2 0 3 TIMES 2 TIMES 1+ REPEAT REPEAT ;
t{ _n2 -> 6 }t

\ ============================================================
\ Group O: miscellaneous ops in loops
\ ============================================================

testing >= comparison
:. _o1 over over >= 2drop IF 2drop -1 ;THEN drop ;
t{ 5 3 _o1 -> -1 }t
t{ 3 5 _o1 -> 3 }t

testing $- match
t{ "ABCD" drop "ABCD" drop 4 $- -> 0 }t

testing $- mismatch
: _o3 "ABCD" drop "XBCD" drop 4 $- 0- 0<> drop IF 1 ELSE 0 THEN ;
t{ _o3 -> 1 }t

testing zlen ( addr -- addr len )
t{ "hello" drop zlen nip -> 5 }t

testing c@+
t{ "AB" drop c@+ swap drop -> 'A' }t

testing c@+ sum loop
: _o6 0 >r BEGIN dup 0- 0> drop WHILE 1- swap c@+ r> + >r swap REPEAT 2drop r> ;
t{ "ABC" drop 3 _o6 -> $C6 }t

\ ============================================================
\ Tier 2: compound patterns (two jumps per loop)
\ ============================================================

testing ;THEN + >r in BWR match
: _p1 5 BEGIN dup 0- 0> drop WHILE
  >r r 3 = 2drop IF r> ;THEN r> 1- REPEAT ;
t{ _p1 -> 3 }t

testing ;THEN + >r in BWR no match
: _p2 0 5 BEGIN dup 0- 0> drop WHILE dup >r + r> 1- REPEAT drop ;
t{ _p2 -> 15 }t

testing IF/ELSE + >r in BWR
\ counter 10→1, r>2→+10 (8 hits=80), r<=2→+1 (2 hits=2). Total=82.
: _p3 0 10 BEGIN dup 0- 0> drop WHILE >r
  r 2 > 2drop IF 10 ELSE 1 THEN + r> 1- REPEAT drop ;
t{ _p3 -> 82 }t

testing multiple ;THEN in BWR
: _p4 5 BEGIN dup 3 = 2drop IF ;THEN
  dup 1 = 2drop IF ;THEN
  dup 0- 0> drop WHILE 1- REPEAT ;
t{ _p4 -> 3 }t

testing helper + IF/ELSE in TR
\ r=4→4, r=3→99, r=2→2, r=1→1, r=0→0. Match(99)→+10, else→+r. Total=17.
: _p5 0 5 TIMES r _kh 99 = 2drop IF 10 ELSE r THEN + REPEAT ;
t{ _p5 -> 17 }t

