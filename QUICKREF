\ --- FPU conversions ---

f>s		( f:n -- n )			FP to 32-bit integer
s>f		( n -- f:n )			32-bit integer to FP
f>df		( f:x -- dl dh )		FP to C double (64-bit)
df>f		( dl dh -- f:x )		C double to FP
fsw@		( -- w )			read FPU status word
fcw@		( -- w )			read FPU control word
fcw!		( w -- )			set FPU control word

\ --- FPU memory ---

f@`		( @ -- f:x )			load float from memory
dupf@`		( @ -- @ f:x )			load float, keep address
f!`		( f:x @ -- )			store float to memory
dupf!`		( f:x @ -- @ )			store float, keep address
f+!`		( f:x @ -- )			add float to memory
f,`		( f:x -- )			compile float at here
flit`		( f:x -- ; -- f:x )		compile float literal
fvariable`	( <name> -- ; -- @ )		define float variable
fconstant`	( f:x <name> -- )		define float constant

\ --- FPU display ---

f.		( f:x -- )			print in scientific notation
f#		( -- @ )			var: significant digits for f.
f.s`		( -- )				dump FP stack
fnumber		( @ # -- f:x )			parse string to float

\ ===== ANS FORTH EQUIVALENTS (not defined — see ff.help) ====
\ invert = ~    and = &    or = |    xor = ^    mod = %
\ not = ~       /mod = /%

\ =============== CONCEPTS ==================================
\ DATAstack  — separate data stack; TOS cached in registers
\ CALLstack  — return stack; also loop counters, >r temps
\ TOS        — top of stack (rightmost in diagrams)
\ NOS        — next of stack (second element)
\ SWAPbit    — SC bit1: which register is TOS vs NOS
\ CALLbit    — SC bit0: data/call stack pointer swap [x86 only]
\ anonymous  — unnamed defs auto-execute on ; (STATE-free)
\ backquote  — ` suffix marks macros (immediate execution)
\ FLAGS      — CPU flags drive conditionals (not booleans)
