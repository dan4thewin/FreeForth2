dup`		( x -- x x )			duplicate TOS (macro: register rename)
2dup`		( x y -- x y x y )		duplicate top two cells
3dup`		( x y z -- x y z x y z )	triplicate top three cells
?dup		( 0 -- 0 | x -- x x )		dup only if TOS nonzero
swap`		( x y -- y x )			exchange TOS/NOS (register rename)
2swap`		( w x y z -- y z w x )		exchange top two pairs
over`		( x y -- x y x )		copy NOS over TOS
2over`		( a b c d -- a b c d a b)	copy 3rd/4th over top pair
under`		( x y -- x x y )		copy NOS under TOS
tuck`		( x y -- y x y )		copy TOS under NOS
nipdup`		( x y -- y y )			overwrite NOS with TOS
pick`		( xn..x0 n -- xn..x0 xn)	copy nth item to TOS (n is literal)
drop`		( n -- )			discard TOS
2drop`		( x y -- )			discard top two cells
nip`		( x y -- y )			discard NOS
rot`		( x y z -- y z x )		rotate 3rd to top
-rot`		( x y z -- z x y )		rotate top to 3rd
>rswapr>`	( x y z -- y x z )		exchange 2nd and 3rd cells
