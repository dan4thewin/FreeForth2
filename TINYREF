depth		( -- n )			net cells pushed since startup

\ =================== RETURN STACK OPS ======================

>r`		( x -- | == x )			move TOS to return stack
2>r`		( x y -- | == x y )		move two cells to return stack
dup>r`		( x -- x | == x )		copy TOS to return stack
2dup>r`		( x y -- x y | == x y )		copy two cells to return stack
r>`		( -- x | x == )			move return stack top to data stack
2r>`		( -- x y | x y == )		move two cells from return stack
dropr>`		( x -- y | y == )		replace TOS with return stack top
r`		( -- x | x == x )		copy return stack top (no pop)
2r`		( -- x y | x y == x y )		copy top two return cells (no pop)
rdrop`		( -- | x == )			discard return stack top
2rdrop`		( -- | x y == )			discard top two return cells
>>r`		( xn..x1 n -- | == x1..xn)	move n cells to return stack
