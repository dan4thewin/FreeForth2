\ ============= NUMBER LITERAL SUFFIXES ====================
\ The compiler handles these on number (or data-label) tokens.
\ Arithmetic suffixes compile the ALU op with an immediate operand.

\ N,     emit mov [rbp], imm (NO rbp advance)
\ N@     compile fetch from address N
\ N!     compile store to address N (consumes TOS)
\ N_     replace TOS with N
\ N+     add N to TOS			[F:ZCSO]
\ N-     subtract N from TOS		[F:ZCSO]
\ N*     multiply TOS by N		[F:--]
\ N/     divide TOS by N		[F:--]
\ N%     modulo TOS by N		[F:--]
\ N&     AND TOS with N			[F:ZS]
\ N|     OR TOS with N			[F:ZS]
\ N^     XOR TOS with N			[F:ZS]

